@model ProjectManager.DAL.Models.ProjectDetailViewModel

@{
    ViewData["Title"] = Model.Project?.Name;
    bool isManager = Context.Session.GetString("IsProjectManager") == "True";
}

<div class="border p-4 mb-4">
    <h3>
        <strong>@Model.Project?.Name</strong>
        <small class="text-muted fs-6">@Model.Project?.Creationdate.ToShortDateString()</small>
    </h3>

    <div class="border p-3 mb-3">
        <p>@Model.Project?.Description</p>
        @if (isManager)
        {
            <a asp-action="EditDescription" asp-route-id="@Model.Project?.ProjectId"
               class="text-primary">Modifier la description</a>
        }
    </div>

    <div class="row">
        <!-- Équipe -->
        <div class="col-md-4">
            <div class="bg-light p-3 rounded">
                <h6 class="text-center fw-bold">Équipe du projet</h6>
                @if (isManager)
                {
                    <div class="text-center mb-2">
                        <a asp-action="AddMember" asp-route-id="@Model.Project?.ProjectId"
                           class="btn btn-success btn-sm">+ Ajouter un membre</a>
                    </div>
                }
                <ul class="list-unstyled">
                    @foreach (var member in Model.Members)
                    {
                        <li class="mb-1">
                            • <a href="mailto:@member.Email">@member.Firstname @member.Lastname</a>
                            @if (member.IsProjectManager)
                            {
                                <span class="text-muted">(Chef de projet)</span>
                            }
                            @if (isManager && !member.IsProjectManager)
                            {
                                <form method="post" asp-action="RemoveMember" style="display:inline;">
                                    <input type="hidden" name="projectId" value="@Model.Project?.ProjectId" />
                                    <input type="hidden" name="employeeId" value="@member.EmployeeId" />
                                    <button type="submit" class="btn btn-link text-danger p-0 ms-1">✕</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Posts -->
        <div class="col-md-8">
            <div class="d-flex justify-content-between mb-2">
                <a asp-controller="Post" asp-action="Create"
                   asp-route-projectId="@Model.Project?.ProjectId"
                   class="text-primary">Rédiger un nouveau post</a>
                <strong>Flux des messages</strong>
            </div>
            @if (Model.Posts.Count == 0)
            {
                <p class="text-muted">Aucun message.</p>
            }
            @foreach (var post in Model.Posts)
            {
                <div class="border p-3 mb-2">
                    <strong>Sujet : @post.Subject</strong><br />
                    <small>
                        Posté par
                        <a href="mailto:@post.Employee?.Email">
                            @post.Employee?.Firstname @post.Employee?.Lastname
                        </a>
                        le @post.SendDate.ToShortDateString()
                    </small>
                    <p class="mb-0 mt-1">@post.Content</p>
                </div>
            }
        </div>
    </div>
</div>