@model List<ProjectManager.DAL.Models.Employee>

@{
    ViewData["Title"] = "Ajouter un membre";
}

<div class="border p-4">
    <h4>Ajouter un membre au projet</h4>

    @if (Model == null || Model.Count == 0)
    {
        <p class="text-muted">Aucun employé disponible.</p>
    }
    else
    {
        <form method="post">
            <input type="hidden" name="projectId" value="@ViewBag.ProjectId" />
            <div class="mb-3">
                <label class="form-label">Choisir un employé</label>
                <select name="employeeId" class="form-select">
                    @foreach (var emp in Model)
                    {
                        <option value="@emp.EmployeeId">@emp.Firstname @emp.Lastname</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-success">Ajouter</button>
            <a asp-action="Details" asp-route-id="@ViewBag.ProjectId" class="btn btn-secondary ms-2">Annuler</a>
        </form>
    }
</div>