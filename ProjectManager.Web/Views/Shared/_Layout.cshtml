<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjectManager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <nav class="navbar navbar-dark bg-dark px-4">
        <span class="navbar-brand">ProjectManager</span>
        <div class="d-flex align-items-center gap-3">
            <span class="text-white fw-bold">
                Bienvenue, @Context.Session.GetString("UserFirstname") @Context.Session.GetString("UserLastname")
            </span>
            @if (Context.Session.GetString("IsProjectManager") == "True")
            {
                <a class="btn btn-success btn-sm" asp-controller="Project" asp-action="Create">+ Créer Projet</a>
            }
            <a class="nav-link text-white" asp-controller="Project" asp-action="Index">Projets</a>
            <a class="nav-link text-white" asp-controller="Post" asp-action="Index">Posts</a>
            <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Logout">Déconnexion</a>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="text-center bg-dark text-white py-3 mt-5">
        ProjectManager - Interface 3 - 2026
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>