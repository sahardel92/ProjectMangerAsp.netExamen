@model List<ProjectManager.DAL.Models.Post>

@{
    ViewData["Title"] = "Posts";
}

<h4 class="mb-4">Flux des messages récents</h4>

<div class="border p-3">
    @if (Model == null || Model.Count == 0)
    {
        <p class="text-muted">Aucun message trouvé.</p>
    }
    else
    {
        @foreach (var post in Model)
        {
            <div class="card mb-3 p-3">
                <div class="d-flex justify-content-between">
                    <h6 class="fw-bold">@post.Subject</h6>
                    <small class="text-muted">
                        Par <a href="mailto:@post.Employee?.Email">@post.Employee?.Firstname @post.Employee?.Lastname</a>
                        • <a asp-controller="Project" asp-action="Details" asp-route-id="@post.ProjectId">@post.Project?.Name</a>
                        • @post.SendDate.ToShortDateString()
                    </small>
                </div>
                <p class="mb-0 mt-1">@post.Content</p>
            </div>
        }
    }
</div>